    "@pixodesk/svg-animator-vue": "workspace:*",
    "@pixodesk/svg-animator-web": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
